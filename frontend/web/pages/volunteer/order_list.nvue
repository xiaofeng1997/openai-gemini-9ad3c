<template>
    <div class="order-list-container">
        <div class="header">
            <h1 class="title">我的预约</h1>
            <div class="tabs">
                <div 
                    v-for="tab in tabs" 
                    :key="tab.key"
                    :class="['tab', { active: currentTab === tab.key }]"
                    @click="switchTab(tab.key)"
                >
                    {{ tab.name }}
                </div>
            </div>
        </div>

        <div class="order-list" v-if="list.length > 0">
            <div 
                v-for="item in list" 
                :key="item.order_id"
                class="order-card"
                @click="goDetail(item.order_id)"
            >
                <div class="order-header">
                    <span class="order-no">订单号: {{ item.order_no }}</span>
                    <span :class="['status', `status-${item.status}`]">{{ getStatusName(item.status) }}</span>
                </div>
                <div class="order-body">
                    <image 
                        class="service-image" 
                        :src="getImagePath(item.service.image)" 
                        mode="aspectFill"
                    />
                    <div class="service-info">
                        <div class="service-name">{{ item.service.name }}</div>
                        <div class="service-meta">
                            <span class="points">{{ item.service.points }}积分</span>
                            <span class="date">{{ formatDate(item.appointment_time) }}</span>
                        </div>
                        <div class="volunteer-info" v-if="item.volunteer">
                            <span>志愿者: {{ item.volunteer.nickname || '未分配' }}</span>
                        </div>
                    </div>
                </div>
                <div class="order-footer" v-if="item.status === 'pending'">
                    <button class="btn-cancel" @click.stop="cancelOrder(item.order_id)">取消预约</button>
                </div>
            </div>
            
            <div class="loading-more" v-if="loading">
                <text>加载中...</text>
            </div>
            <div class="no-more" v-else-if="list.length >= total">
                <text>没有更多了</text>
            </div>
        </div>

        <div class="empty-state" v-else-if="!loading">
            <image class="empty-icon" src="/static/images/empty.png" mode="aspectFit" />
            <text class="empty-text">暂无订单记录</text>
            <button class="btn-go" @click="goIndex">去预约服务</button>
        </div>
    </div>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { getVolunteerOrderLists, cancelVolunteerOrder } from '@/api/volunteer'

const currentTab = ref('all')
const tabs = [
    { key: 'all', name: '全部' },
    { key: 'pending', name: '待服务' },
    { key: 'serving', name: '服务中' },
    { key: 'completed', name: '已完成' },
    { key: 'cancelled', name: '已取消' }
]
const list = ref<any[]>([])
const loading = ref(false)
const page = ref(1)
const total = ref(0)

const getStatusName = (status: string) => {
    const statusMap: Record<string, string> = {
        pending: '待确认',
        serving: '服务中',
        completed: '已完成',
        cancelled: '已取消'
    }
    return statusMap[status] || status
}

const getImagePath = (path: string) => {
    if (!path) return '/static/images/default.png'
    if (path.startsWith('http')) return path
    return import.meta.env.VITE_APP_IMG_URL + path
}

const formatDate = (timestamp: number) => {
    if (!timestamp) return ''
    const date = new Date(timestamp * 1000)
    return `${date.getMonth() + 1}/${date.getDate()} ${date.getHours()}:${String(date.getMinutes()).padStart(2, '0')}`
}

const switchTab = (key: string) => {
    currentTab.value = key
    page.value = 1
    list.value = []
    loadList()
}

const loadList = async () => {
    if (loading.value) return
    loading.value = true
    
    try {
        const params: any = { page: page.value, limit: 10 }
        if (currentTab.value !== 'all') {
            params.status = currentTab.value
        }
        
        const res = await getVolunteerOrderLists(params)
        
        if (page.value === 1) {
            list.value = res.lists || []
        } else {
            list.value = [...list.value, ...(res.lists || [])]
        }
        total.value = res.count || 0
    } catch (error) {
        console.error('加载订单列表失败', error)
    } finally {
        loading.value = false
    }
}

const goDetail = (orderId: number) => {
    uni.navigateTo({ url: `/pages/volunteer/order_detail?id=${orderId}` })
}

const goIndex = () => {
    uni.switchTab({ url: '/pages/volunteer/index' })
}

const cancelOrder = async (orderId: number) => {
    uni.showModal({
        title: '提示',
        content: '确定要取消该预约吗？',
        success: async (res) => {
            if (res.confirm) {
                try {
                    await cancelVolunteerOrder({ order_id: orderId })
                    uni.showToast({ title: '取消成功', icon: 'success' })
                    list.value = []
                    page.value = 1
                    loadList()
                } catch (error: any) {
                    uni.showToast({ title: error.message || '取消失败', icon: 'none' })
                }
            }
        }
    })
}

const onReachBottom = () => {
    if (list.value.length < total.value) {
        page.value++
        loadList()
    }
}

onMounted(() => {
    loadList()
})
</script>

<style lang="scss" scoped>
.order-list-container {
    min-height: 100vh;
    background: #f5f5f5;
}

.header {
    background: #fff;
    padding: 30rpx;
    position: sticky;
    top: 0;
    z-index: 10;
}

.title {
    font-size: 36rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 24rpx;
}

.tabs {
    display: flex;
    gap: 24rpx;
}

.tab {
    font-size: 28rpx;
    color: #666;
    padding-bottom: 8rpx;
    position: relative;
    
    &.active {
        color: #1890ff;
        font-weight: 500;
        
        &::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 40rpx;
            height: 4rpx;
            background: #1890ff;
            border-radius: 2rpx;
        }
    }
}

.order-list {
    padding: 24rpx;
}

.order-card {
    background: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 24rpx;
}

.order-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.order-no {
    font-size: 24rpx;
    color: #999;
}

.status {
    font-size: 26rpx;
    font-weight: 500;
    
    &.status-pending { color: #ff8800; }
    &.status-serving { color: #1890ff; }
    &.status-completed { color: #52c41a; }
    &.status-cancelled { color: #999; }
}

.order-body {
    display: flex;
    gap: 20rpx;
}

.service-image {
    width: 160rpx;
    height: 160rpx;
    border-radius: 12rpx;
    background: #f5f5f5;
}

.service-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.service-name {
    font-size: 30rpx;
    font-weight: 500;
    color: #333;
    line-height: 1.4;
}

.service-meta {
    display: flex;
    align-items: center;
    gap: 16rpx;
    font-size: 26rpx;
    
    .points {
        color: #ff6b00;
        font-weight: 500;
    }
    
    .date {
        color: #999;
    }
}

.volunteer-info {
    font-size: 24rpx;
    color: #666;
}

.order-footer {
    margin-top: 20rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid #f0f0f0;
    display: flex;
    justify-content: flex-end;
}

.btn-cancel {
    padding: 12rpx 32rpx;
    font-size: 26rpx;
    color: #666;
    background: #f5f5f5;
    border: none;
    border-radius: 32rpx;
}

.loading-more,
.no-more {
    text-align: center;
    padding: 30rpx;
    font-size: 26rpx;
    color: #999;
}

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 0;
}

.empty-icon {
    width: 200rpx;
    height: 200rpx;
    opacity: 0.5;
}

.empty-text {
    font-size: 28rpx;
    color: #999;
    margin: 24rpx 0;
}

.btn-go {
    padding: 20rpx 60rpx;
    font-size: 28rpx;
    color: #fff;
    background: linear-gradient(135deg, #1890ff, #096dd9);
    border: none;
    border-radius: 40rpx;
}
</style>
