    flex: 1;
    display: flex;
    flex-direction: column;
}

.service-name {
    font-size: 30rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 8rpx;
}

.service-desc {
    font-size: 26rpx;
    color: #999;
    margin-bottom: 12rpx;
    flex: 1;
}

.service-points {
    font-size: 32rpx;
    font-weight: 600;
    color: #ff6b00;
}

.info-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 20rpx 0;
    border-bottom: 1rpx solid #f0f0f0;
    
    &:last-child {
        border-bottom: none;
    }
}

