        color: #ff8800;
        margin-bottom: 12rpx;
    }
    
    .evaluation-text {
        font-size: 28rpx;
        color: #666;
        line-height: 1.6;
    }
}

.bottom-bar {
    position: fixed;
    bottom: 0;
