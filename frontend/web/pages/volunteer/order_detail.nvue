<template>
    <div class="order-detail-container" v-if="detail">
        <div class="section status-section">
            <div class="status-icon" :class="`status-${detail.status}`">
                <text v-if="detail.status === 'pending'">待确认</text>
                <text v-else-if="detail.status === 'serving'">服务中</text>
                <text v-else-if="detail.status === 'completed'">已完成</text>
                <text v-else>已取消</text>
            </div>
            <div class="status-desc" v-if="detail.status === 'pending'">请等待志愿者确认服务</div>
            <div class="status-desc" v-else-if="detail.status === 'serving'">志愿者正在为您服务</div>
            <div class="status-desc" v-else-if="detail.status === 'completed'">服务已完成，感谢您的参与</div>
        </div>

        <div class="section service-section">
            <div class="section-title">服务信息</div>
            <div class="service-card">
                <image 
                    class="service-image" 
                    :src="getImagePath(detail.service.image)" 
                    mode="aspectFill"
                />
                <div class="service-info">
                    <div class="service-name">{{ detail.service.name }}</div>
                    <div class="service-desc">{{ detail.service.desc }}</div>
                    <div class="service-points">{{ detail.service.points }} 积分</div>
                </div>
            </div>
        </div>

        <div class="section info-section">
            <div class="section-title">预约信息</div>
            <div class="info-item">
                <text class="info-label">预约时间</text>
                <text class="info-value">{{ formatDateTime(detail.appointment_time) }}</text>
            </div>
            <div class="info-item">
                <text class="info-label">预约地点</text>
                <text class="info-value">{{ detail.address || '未指定' }}</text>
            </div>
            <div class="info-item">
                <text class="info-label">联系电话</text>
                <text class="info-value">{{ detail.mobile || '未填写' }}</text>
            </div>
            <div class="info-item" v-if="detail.remark">
                <text class="info-label">备注</text>
                <text class="info-value">{{ detail.remark }}</text>
            </div>
        </div>

        <div class="section volunteer-section" v-if="detail.volunteer">
            <div class="section-title">志愿者信息</div>
            <div class="volunteer-card">
                <image 
                    class="volunteer-avatar" 
                    :src="getImagePath(detail.volunteer.avatar)" 
                    mode="aspectFill"
                />
                <div class="volunteer-info">
                    <div class="volunteer-name">{{ detail.volunteer.nickname || detail.volunteer.name }}</div>
                    <div class="volunteer-meta">
                        <text>服务 {{ detail.volunteer.serve_count || 0 }} 次</text>
                        <text class="rating" v-if="detail.volunteer.rating">★ {{ detail.volunteer.rating.toFixed(1) }}</text>
                    </div>
                </div>
                <button class="btn-contact" @click="contactVolunteer">联系</button>
            </div>
        </div>

        <div class="section order-section">
            <div class="section-title">订单信息</div>
            <div class="info-item">
                <text class="info-label">订单编号</text>
                <text class="info-value">{{ detail.order_no }}</text>
            </div>
            <div class="info-item">
                <text class="info-label">下单时间</text>
                <text class="info-value">{{ formatDateTime(detail.create_time) }}</text>
            </div>
        </div>

        <div class="section evaluation-section" v-if="detail.status === 'completed' && !detail.evaluation">
            <div class="section-title">服务评价</div>
            <div class="rating-box">
                <text class="rating-label">服务评分</text>
                <div class="rating-stars">
                    <text 
                        v-for="i in 5" 
                        :key="i"
                        :class="['star', { active: i <= evaluation.rating }]"
                        @click="evaluation.rating = i"
                    >★</text>
                </div>
            </div>
            <textarea 
                class="evaluation-content"
                v-model="evaluation.content"
                placeholder="请分享您的服务体验..."
                maxlength="200"
            />
            <button class="btn-submit" @click="submitEvaluation">提交评价</button>
        </div>

        <div class="section evaluation-section" v-if="detail.evaluation">
            <div class="section-title">我的评价</div>
            <div class="evaluation-display">
                <div class="evaluation-rating">★ {{ detail.evaluation.rating }}分</div>
                <div class="evaluation-text">{{ detail.evaluation.content || '该用户未填写评价' }}</div>
            </div>
        </div>

        <div class="bottom-bar" v-if="detail.status === 'pending'">
            <button class="btn-cancel" @click="cancelOrder">取消预约</button>
        </div>
    </div>
    
    <div class="loading" v-else>
        <text>加载中...</text>
    </div>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { getVolunteerOrderDetail, cancelVolunteerOrder, addVolunteerEvaluation } from '@/api/volunteer'

const orderId = ref(0)
const detail = ref<any>(null)
const evaluation = ref({
    rating: 5,
    content: ''
})

const getImagePath = (path: string) => {
    if (!path) return '/static/images/default.png'
    if (path.startsWith('http')) return path
    return import.meta.env.VITE_APP_IMG_URL + path
}

const formatDateTime = (timestamp: number) => {
    if (!timestamp) return ''
    const date = new Date(timestamp * 1000)
    const year = date.getFullYear()
    const month = String(date.getMonth() + 1).padStart(2, '0')
    const day = String(date.getDate()).padStart(2, '0')
    const hours = String(date.getHours()).padStart(2, '0')
    const minutes = String(date.getMinutes()).padStart(2, '0')
    return `${year}-${month}-${day} ${hours}:${minutes}`
}

const loadDetail = async () => {
    try {
        const res = await getVolunteerOrderDetail({ order_id: orderId.value })
        detail.value = res
    } catch (error) {
        console.error('加载订单详情失败', error)
        uni.showToast({ title: '加载失败', icon: 'none' })
    }
}

const contactVolunteer = () => {
    if (detail.value?.volunteer?.mobile) {
        uni.makePhoneCall({ phoneNumber: detail.value.volunteer.mobile })
    }
}

const cancelOrder = async () => {
    uni.showModal({
        title: '提示',
        content: '确定要取消该预约吗？',
        success: async (res) => {
            if (res.confirm) {
                try {
                    await cancelVolunteerOrder({ order_id: orderId.value })
                    uni.showToast({ title: '取消成功', icon: 'success' })
                    loadDetail()
                } catch (error: any) {
                    uni.showToast({ title: error.message || '取消失败', icon: 'none' })
                }
            }
        }
    })
}

const submitEvaluation = async () => {
    if (evaluation.value.rating === 0) {
        uni.showToast({ title: '请选择评分', icon: 'none' })
        return
    }
    
    try {
        await addVolunteerEvaluation({
            order_id: orderId.value,
            rating: evaluation.value.rating,
            content: evaluation.value.content
        })
        uni.showToast({ title: '评价成功', icon: 'success' })
        loadDetail()
    } catch (error: any) {
        uni.showToast({ title: error.message || '评价失败', icon: 'none' })
    }
}

onMounted(() => {
    const pages = getCurrentPages()
    const currentPage = pages[pages.length - 1] as any
    const options = currentPage.options || {}
    orderId.value = parseInt(options.id) || 0
    
    if (orderId.value) {
        loadDetail()
    }
})
</script>

<style lang="scss" scoped>
.order-detail-container {
    min-height: 100vh;
    background: #f5f5f5;
    padding-bottom: 120rpx;
}

.section {
    background: #fff;
    margin-bottom: 20rpx;
    padding: 30rpx;
}

