    &.active {
        color: #ff8800;
    }
}

.evaluation-content {
    width: 100%;
    height: 200rpx;
    padding: 20rpx;
    font-size: 28rpx;
    color: #333;
    background: #f9f9f9;
    border-radius: 12rpx;
    box-sizing: border-box;
    margin-bottom: 20rpx;
}

.btn-submit {
    width: 100%;
