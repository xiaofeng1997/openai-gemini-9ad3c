    min-height: 100vh;
    background: #f5f5f5;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    background: #fff;
}

.title {
    font-size: 36rpx;
    font-weight: 600;
    color: #333;
}

