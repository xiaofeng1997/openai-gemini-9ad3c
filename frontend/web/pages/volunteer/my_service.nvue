<template>
    <div class="my-service-container">
        <div class="header">
            <h1 class="title">我的发布</h1>
            <button class="btn-add" @click="goPublish">发布服务</button>
        </div>

        <div class="service-list" v-if="list.length > 0">
            <div 
                v-for="item in list" 
                :key="item.id"
                class="service-card"
                @click="goDetail(item.id)"
            >
                <image 
                    class="service-image" 
                    :src="getImagePath(item.image)" 
                    mode="aspectFill"
                />
                <div class="service-info">
                    <div class="service-name">{{ item.name }}</div>
                    <div class="service-meta">
                        <text class="points">{{ item.points }}积分/次</text>
                        <text class="status">{{ item.status === 1 ? '上架' : '下架' }}</text>
                    </div>
                    <div class="service-stats">
                        <text>浏览 {{ item.view_count || 0 }}</text>
                        <text>预约 {{ item.order_count || 0 }}</text>
                    </div>
                </div>
                <div class="action-btns">
                    <button class="btn-edit" @click.stop="goEdit(item.id)">编辑</button>
                    <button 
                        class="btn-toggle" 
                        @click.stop="toggleStatus(item)"
                    >
                        {{ item.status === 1 ? '下架' : '上架' }}
                    </button>
                </div>
            </div>
        </div>

        <div class="empty-state" v-else>
            <text class="empty-text">您还没有发布任何服务</text>
            <button class="btn-go" @click="goPublish">去发布</button>
        </div>
    </div>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { getMyPublishService, toggleServiceStatus } from '@/api/volunteer'

const list = ref<any[]>([])

const getImagePath = (path: string) => {
    if (!path) return '/static/images/default.png'
    if (path.startsWith('http')) return path
    return import.meta.env.VITE_APP_IMG_URL + path
}

const loadList = async () => {
    try {
        const res = await getMyPublishService()
        list.value = res.lists || []
    } catch (error) {
        console.error('加载失败', error)
    }
}

const goPublish = () => {
    uni.navigateTo({ url: '/pages/volunteer/publish_service' })
}

const goDetail = (id: number) => {
    uni.navigateTo({ url: `/pages/volunteer/detail?id=${id}` })
}

const goEdit = (id: number) => {
    uni.navigateTo({ url: `/pages/volunteer/edit_service?id=${id}` })
}

const toggleStatus = async (item: any) => {
    try {
        await toggleServiceStatus({ id: item.id })
        uni.showToast({ title: '操作成功', icon: 'success' })
        item.status = item.status === 1 ? 0 : 1
    } catch (error: any) {
        uni.showToast({ title: error.message || '操作失败', icon: 'none' })
    }
}

onMounted(() => {
    loadList()
})
</script>

