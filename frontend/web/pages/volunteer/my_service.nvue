    padding: 20rpx;
}

.service-card {
    display: flex;
    background: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    gap: 20rpx;
}

.service-image {
    width: 200rpx;
    height: 200rpx;
    border-radius: 12rpx;
    background: #f5f5f5;
}

.service-info {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.service-name {
    font-size: 30rpx;
    font-weight: 500;
    color: #333;
    margin-bottom: 12rpx;
}

.service-meta {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin-bottom: 12rpx;
    
    .points {
        font-size: 28rpx;
        color: #ff6b00;
        font-weight: 500;
    }
    
    .status {
        font-size: 24rpx;
        color: #52c41a;
        padding: 4rpx 12rpx;
        background: #f6ffed;
        border-radius: 4rpx;
    }
}

.service-stats {
    display: flex;
    gap: 20rpx;
    font-size: 24rpx;
    color: #999;
}

.action-btns {
    display: flex;
    flex-direction: column;
    gap: 12rpx;
    justify-content: center;
}

.btn-edit,
.btn-toggle {
    padding: 12rpx 24rpx;
    font-size: 24rpx;
    border: none;
    border-radius: 8rpx;
}

.btn-edit {
    color: #666;
    background: #f5f5f5;
}

.btn-toggle {
    color: #1890ff;
    background: #e6f7ff;
}

.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 120rpx 0;
}

.empty-text {
    font-size: 28rpx;
    color: #999;
    margin-bottom: 24rpx;
}

.btn-go {
    padding: 20rpx 60rpx;
    font-size: 28rpx;
    color: #fff;
    background: #1890ff;
    border: none;
    border-radius: 40rpx;
}
</style>
