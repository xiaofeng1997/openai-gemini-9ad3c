<template>
    <div class="apply-container">
        <div class="header">
            <text class="title">申请成为志愿者</text>
            <text class="subtitle">用您的爱心帮助更多人</text>
        </div>

        <div class="form-section">
            <div class="form-item">
                <text class="label">真实姓名</text>
                <input 
                    class="input" 
                    v-model="form.name" 
                    placeholder="请输入真实姓名"
                    maxlength="20"
                />
            </div>
            
            <div class="form-item">
                <text class="label">联系电话</text>
                <input 
                    class="input" 
                    v-model="form.mobile" 
                    placeholder="请输入联系电话"
                    type="number"
                    maxlength="11"
                />
            </div>
            
            <div class="form-item">
                <text class="label">服务类别</text>
                <picker 
                    mode="selector" 
                    :range="categoryList" 
                    range-key="name"
                    @change="onCategoryChange"
                >
                    <div class="picker-box">
                        <text :class="['picker-value', { placeholder: !form.category_id }]">
                            {{ selectedCategoryName || '请选择服务类别' }}
                        </text>
                        <text class="picker-arrow">></text>
                    </div>
                </picker>
            </div>
            
            <div class="form-item">
                <text class="label">个人简介</text>
                <textarea 
                    class="textarea" 
                    v-model="form.intro" 
                    placeholder="请简单介绍一下自己，包括您的特长、服务经验等"
                    maxlength="500"
                />
            </div>
            
            <div class="form-item">
                <text class="label">上传证件照</text>
                <div class="upload-box" @click="chooseImage">
                    <image 
                        v-if="form.certificate" 
                        :src="getImagePath(form.certificate)" 
                        mode="aspectFill"
                        class="upload-image"
                    />
                    <text v-else class="upload-placeholder">+</text>
                </div>
                <text class="upload-tip">上传身份证或相关资质证明</text>
            </div>
        </div>

        <div class="rules-section">
            <div class="rules-title">志愿者须知</div>
            <div class="rules-content">
                <text>1. 志愿者需年满18周岁，身体健康</text>
                <text>2. 热爱公益事业，愿意帮助他人</text>
                <text>3. 遵守平台规则，按时完成服务</text>
                <text>4. 积分门槛需达到500分以上</text>
            </div>
        </div>

        <div class="bottom-bar">
            <button class="btn-submit" :disabled="submitting" @click="submitApply">
                {{ submitting ? '提交中...' : '提交申请' }}
            </button>
        </div>
    </div>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
import { getVolunteerCategoryLists, applyVolunteer } from '@/api/volunteer'

const categoryList = ref<any[]>([])
const submitting = ref(false)
const form = ref({
    name: '',
    mobile: '',
    category_id: 0,
    intro: '',
    certificate: ''
})

const selectedCategoryName = computed(() => {
    const category = categoryList.value.find(c => c.id === form.value.category_id)
    return category?.name || ''
})

const getImagePath = (path: string) => {
    if (!path) return ''
    if (path.startsWith('http')) return path
    return import.meta.env.VITE_APP_IMG_URL + path
}

const onCategoryChange = (e: any) => {
    const index = e.detail.value
    form.value.category_id = categoryList.value[index].id
}

const chooseImage = () => {
    uni.chooseImage({
        count: 1,
        sizeType: ['compressed'],
        sourceType: ['album', 'camera'],
        success: (res) => {
            const tempPath = res.tempFilePaths[0]
            uni.uploadFile({
                url: import.meta.env.VITE_APP_API_URL + '/upload/image',
                filePath: tempPath,
                name: 'file',
                success: (uploadRes) => {
                    const data = JSON.parse(uploadRes.data)
                    if (data.code === 1) {
                        form.value.certificate = data.url
                    }
                }
            })
        }
    })
}

const loadCategories = async () => {
    try {
        const res = await getVolunteerCategoryLists()
        categoryList.value = res.lists || []
    } catch (error) {
        console.error('加载分类失败', error)
    }
}

const submitApply = async () => {
    if (!form.value.name.trim()) {
        uni.showToast({ title: '请输入姓名', icon: 'none' })
        return
    }
    if (!form.value.mobile.trim() || !/^1\d{10}$/.test(form.value.mobile)) {
        uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
        return
    }
    if (!form.value.category_id) {
        uni.showToast({ title: '请选择服务类别', icon: 'none' })
        return
    }
    if (!form.value.intro.trim()) {
        uni.showToast({ title: '请输入个人简介', icon: 'none' })
        return
    }

    submitting.value = true
    try {
        await applyVolunteer(form.value)
        uni.showToast({ title: '提交成功', icon: 'success' })
        setTimeout(() => {
            uni.navigateBack()
        }, 1500)
    } catch (error: any) {
        uni.showToast({ title: error.message || '提交失败', icon: 'none' })
    } finally {
        submitting.value = false
    }
}

onMounted(() => {
    loadCategories()
})
</script>

